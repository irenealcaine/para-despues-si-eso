# Firebase configuration (client-side, NOT secret - safe to commit shape, values are yours)
# Copy this file to .env and fill in the values from your Firebase project:
#   Firebase Console > Project settings > General > "Your apps" > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: only used by Firebase Analytics (not used by this app)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=